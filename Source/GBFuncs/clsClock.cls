Option Explicit

Private Declare Function GetTickCount Lib "kernel32" () As Long
Private m_Start&
Public Sub StartClock()

    m_Start& = GetTickCount()

End Sub

Public Property Get TimeTaken() As String

    Dim lngTick&
    Dim sglTimeTaken As Single

    lngTick& = (GetTickCount() - m_Start&)
    sglTimeTaken = lngTick& / 1000
    TimeTaken = Format$(sglTimeTaken, "0.00")

End Property

Private Sub Class_Initialize()
    m_Start& = 0&
End Sub


